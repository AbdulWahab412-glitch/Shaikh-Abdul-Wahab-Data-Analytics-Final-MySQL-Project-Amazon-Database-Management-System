/*
=========================================
1. Customer table
=========================================
*/

-- Add date_of_birth column
ALTER TABLE customers ADD date_of_birth DATE;

-- Add gender column
ALTER TABLE customers ADD gender VARCHAR(10);

-- Modify phone column size
ALTER TABLE customers MODIFY phone VARCHAR(20);

-- Rename column name to customer_name
ALTER TABLE customers RENAME COLUMN name TO customer_name;

-- Add default city value
ALTER TABLE customers ALTER city SET DEFAULT 'Mumbai';

-- Drop gender column
ALTER TABLE customers DROP COLUMN gender;

-- Add unique constraint on email
ALTER TABLE customers ADD CONSTRAINT unique_email UNIQUE(email);

-- Rename table customers_backup
ALTER TABLE customers RENAME TO customers_backup;

-- Rename table back to customers
ALTER TABLE customers_backup RENAME TO customers;

-- Add status column
ALTER TABLE customers ADD status VARCHAR(20);

